{
  "name": "Balanced (default)",
  "target": "RTX 3060-class GPU / 6-core CPU / 16+ GB RAM; tuned on RTX 5070 + Ryzen 5 9600X + 32 GB",
  "jvm": {
    "min_mb": 4096,
    "max_mb": 10240,
    "args": "-XX:+UseZGC -XX:+ZGenerational -XX:+AlwaysPreTouch -XX:+DisableExplicitGC -XX:+PerfDisableSharedMem"
  },
  "vanilla": {
    "renderDistance": 12,
    "simulationDistance": 8,
    "maxFps": 260,
    "graphicsMode": 1,
    "particles": 0,
    "entityDistanceScaling": 1.0
  },
  "voxy": {
    "enabled": true,
    "sectionRenderDistance": 16,
    "serviceThreads": 3
  },
  "voxyWorldgen": {
    "enabled": true,
    "generationRadius": 96,
    "maxActiveTasks": 4,
    "maxQueueSize": 12000
  },
  "shader": {
    "pack": "ComplementaryReimagined",
    "preset": "MEDIUM"
  },
  "effects": "balanced",
  "shader_alternates": [
    {
      "id": "photon",
      "pack": "photon",
      "preset": "medium",
      "note": "Photon v1.4, Voxy-aware"
    },
    {
      "id": "noble",
      "pack": "Noble",
      "preset": "MEDIUM",
      "note": "Optional: Noble 1.9.9, Voxy-aware"
    },
    {
      "id": "bliss",
      "pack": "Bliss",
      "preset": null,
      "note": "Optional: Bliss 2.1.2 has NO Voxy support: distant terrain is unshaded/hidden. Pack defaults."
    }
  ]
}

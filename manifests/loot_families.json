{
  "_comment": [
    "Curated reward identities for Project Horizon (read by scripts/gen_datapack.py).",
    "tables: ordered [regex, family] rules over loot-table ids; FIRST match wins. Unmatched tables get no Horizon injection.",
    "structures: ordered [regex, family] rules over structure ids, used for #horizon:family/<id> tags (advancements, maps, quests).",
    "roles: a table's role comes from the first role regex that matches its path (vault > filler > standard).",
    "budget: EXPECTED count per full clear of ONE structure (template group). The generator solves per-table chances so that",
    "no structure group exceeds its budget (shared tables take the minimum), then clamps to max_chance.",
    "split: how a family's budget for each reward is shared between roles (missing roles hand their share to the next role).",
    "Relic tiers stay the same three currencies; regional tokens are horizontal (where you went), not a fourth tier."
  ],
  "roles": {
    "vault": "(treasure|elite|vault|throne|hoard|secret|reward|apex|pharaoh|jackpot|puzzle_treasure|sudoku_success|legendary|_high$|/rare$|keep$|obsidian$|coffin)",
    "filler": "(junk|food|kitchen|suppl|storage|barrel|generic|common|normal|garden|rooms|library|bookshelf|lesser|_low$|/low$|filler|waste|mess|quarters|hallway|corridor|grave|wool|cask|housing|failed|lumberjack|farmer|brewery|component)",
    "skip": "(^|/)(pots?|pot_[a-z_]+|archaeology|archeology|archaelogy|dispensers?|spawn_bonus_chest|inject)(/|$)"
  },
  "split": {
    "heart": {
      "vault": 1.0
    },
    "core": {
      "vault": 0.7,
      "standard": 0.3,
      "filler": 0.0
    },
    "shard": {
      "standard": 0.6,
      "filler": 0.4,
      "vault": 0.0
    },
    "token": {
      "vault": 0.35,
      "standard": 0.5,
      "filler": 0.15
    },
    "affix": {
      "vault": 0.45,
      "standard": 0.4,
      "filler": 0.15
    },
    "gem": {
      "vault": 0.45,
      "standard": 0.4,
      "filler": 0.15
    }
  },
  "max_chance": {
    "heart": 0.5,
    "core": 0.5,
    "shard": 0.6,
    "token": 0.7,
    "affix": 0.6,
    "gem": 0.45
  },
